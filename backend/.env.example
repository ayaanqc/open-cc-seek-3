# Copy to .env and adjust for your environment.
# .env is gitignored; this example file is safe to commit.

# Port the Express server binds to.
PORT=4000

# development | production | test
NODE_ENV=development

# Comma-separated list of origins allowed by CORS.
# Use * to allow any origin (not recommended for production).
CORS_ORIGIN=http://localhost:5173

# Reserved for future database integration. Leave empty until a DB is wired in.
DATABASE_URL=
