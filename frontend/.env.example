# Backend base URL. In development the Vite proxy forwards /api to the
# Express server, so a relative path is enough.
# For production, set this to the deployed API origin, e.g.:
# VITE_API_URL=https://api.opticore.example.com
VITE_API_URL=/api

# Vite dev server port.
VITE_PORT=5173

# Backend origin proxied by /api during development.
VITE_PROXY_TARGET=http://localhost:4000
